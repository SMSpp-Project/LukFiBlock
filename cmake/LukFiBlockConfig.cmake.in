# This file contains instructions on how to generate the LukFiBlockConfig.cmake file

get_filename_component(LukFiBlock_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

find_package(Boost REQUIRED)
find_package(Eigen3 REQUIRED)
find_package(SMSpp REQUIRED)

if(NOT TARGET SMS++::LukFiBlock)
    include("${LukFiBlock_CMAKE_DIR}/LukFiBlockTargets.cmake")
endif()

set(LukFiBlock_LIBRARIES SMS++::LukFiBlock)
